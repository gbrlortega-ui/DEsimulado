rules_version = '2';

// DEsimulados — progresso dos alunos.
// Cada aluno só lê e grava o próprio documento em alunos/{uid}. Todo o resto fica fechado.
service cloud.firestore {
  match /databases/{database}/documents {

    match /alunos/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validAluno() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nome', 'email', 'historico', 'emAndamento', 'criadoEm', 'atualizadoEm'])
          && (!('historico' in d) || (d.historico is list && d.historico.size() <= 100))
          && (!('emAndamento' in d) || d.emAndamento == null || d.emAndamento is map)
          && (!('nome' in d) || (d.nome is string && d.nome.size() <= 200))
          && (!('email' in d) || (d.email is string && d.email.size() <= 320));
      }
      allow get, delete: if isOwner(); // sem "list": ninguém lista a coleção de alunos
      allow create, update: if isOwner() && validAluno();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
